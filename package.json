{
  "name": "tic-tac-toe",
  "version": "2.0.0",
  "private": true,
  "description": "Tic-tac-toe against an unbeatable minimax AI. Framework-free TypeScript, built with Vite.",
  "license": "MIT",
  "author": "Michael Gray",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
